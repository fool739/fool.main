---
// Live music tracking via the Lanyard webhook/API (Discord presence -> Spotify).
// variant "nav"  : hides itself entirely when nothing is playing
// variant "stat" : always visible, shows a muted fallback when idle
const DISCORD_ID = "720005508173529169";

interface Props {
    variant?: 'nav' | 'stat';
}

const { variant = 'nav' } = Astro.props;
---

{variant === 'nav' ? (
    <div class="now-playing hidden items-center gap-2 text-sm text-neutral-500" data-variant="nav">
        <span class="select-none">&#9834;</span>
        <a
            class="spotify-link glow-hover max-w-[200px] truncate text-neutral-600 no-underline transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span class="song-name"></span>
        </a>
    </div>
) : (
    <span class="now-playing min-w-0" data-variant="stat">
        <a
            class="spotify-link glow-hover pointer-events-none inline-block max-w-full truncate align-bottom text-neutral-500 no-underline transition-colors dark:text-neutral-500"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span class="song-name">silence</span>
        </a>
    </span>
)}

<script define:vars={{ DISCORD_ID }}>
    async function fetchNowPlaying() {
        try {
            const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`);
            const data = await response.json();

            const containers = document.querySelectorAll('.now-playing');

            containers.forEach(container => {
                const songName = container.querySelector('.song-name');
                const spotifyLink = container.querySelector('.spotify-link');
                const isStat = container.dataset.variant === 'stat';

                if (data.success && data.data.spotify) {
                    const spotify = data.data.spotify;
                    const trackName = `${spotify.song} - ${spotify.artist}`;

                    songName.textContent = trackName;
                    spotifyLink.href = `https://open.spotify.com/track/${spotify.track_id}`;
                    spotifyLink.title = trackName;

                    if (isStat) {
                        spotifyLink.classList.remove('pointer-events-none');
                        spotifyLink.classList.add('hover:text-neutral-900', 'dark:hover:text-neutral-100');
                    } else {
                        container.classList.remove('hidden');
                        container.classList.add('flex');
                    }
                } else {
                    if (isStat) {
                        songName.textContent = 'silence';
                        spotifyLink.removeAttribute('title');
                        spotifyLink.href = '#';
                        spotifyLink.classList.add('pointer-events-none');
                        spotifyLink.classList.remove('hover:text-neutral-900', 'dark:hover:text-neutral-100');
                    } else {
                        container.classList.add('hidden');
                        container.classList.remove('flex');
                    }
                }
            });
        } catch (error) {
            console.error('Failed to fetch Lanyard data:', error);
        }
    }

    // Only run once globally
    if (!window.nowPlayingInitialized) {
        window.nowPlayingInitialized = true;
        fetchNowPlaying();
        setInterval(fetchNowPlaying, 30000);
    }
</script>
