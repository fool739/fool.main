---
import { getCollection } from 'astro:content';
import NowPlaying from '../components/NowPlaying.astro';
import status from '../data/status.json';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
const latestSlug = latest ? latest.id.replace(/\.[^.]+$/, '') : null;

function timeAgo(date: Date): string {
    const seconds = Math.floor((Date.now() - date.valueOf()) / 1000);
    const units: [number, string][] = [
        [31536000, 'y'],
        [2592000, 'mo'],
        [604800, 'w'],
        [86400, 'd'],
        [3600, 'h'],
        [60, 'm'],
    ];
    for (const [span, label] of units) {
        const value = Math.floor(seconds / span);
        if (value >= 1) return `${value}${label} ago`;
    }
    return 'just now';
}

const ascii = String.raw`  __                 _
 / _|  ___     ___  | |
| |_  / _ \   / _ \ | |
|  _|| (_) | | (_) || |
|_|   \___/   \___/ |_|`;
---

<header data-pagefind-ignore class="flex flex-1 items-center justify-center py-10">
    <div class="w-full max-w-md border border-neutral-200 bg-neutral-100/60 p-6 dark:border-neutral-800 dark:bg-neutral-900/60 sm:p-8">

        <!-- ascii mark -->
        <pre aria-hidden="true" class="select-none overflow-x-auto text-center text-[10px] leading-tight text-neutral-900 dark:text-neutral-100 sm:text-xs">{ascii}</pre>
        <p class="mt-3 text-center text-sm text-neutral-500">live to die<span class="cursor-blink">_</span></p>

        <!-- stats -->
        <div class="mt-8 border border-neutral-200 dark:border-neutral-800">
            <div class="flex items-baseline justify-between border-b border-neutral-200 px-3 py-2 text-xs dark:border-neutral-800">
                <span class="font-bold text-neutral-700 dark:text-neutral-300">fool_data</span>
                {latest && (
                    <span class="text-neutral-400 dark:text-neutral-600">({timeAgo(latest.data.date)})</span>
                )}
            </div>

            <div class="flex flex-col gap-2.5 px-3 py-3 text-xs sm:text-sm">
                <div class="flex items-baseline">
                    <span class="shrink-0 text-neutral-600 dark:text-neutral-400">latest_post</span>
                    <span class="mx-2 mb-1 flex-1 border-b border-dotted border-neutral-300 dark:border-neutral-700"></span>
                    {latest ? (
                        <a href={`/blog/${latestSlug}`} class="min-w-0 truncate text-right text-neutral-800 no-underline transition-colors hover:text-neutral-500 dark:text-neutral-200 dark:hover:text-neutral-400">
                            {latest.data.title}
                        </a>
                    ) : (
                        <span class="text-neutral-500">none yet</span>
                    )}
                </div>

                <div class="flex items-baseline">
                    <span class="shrink-0 text-neutral-600 dark:text-neutral-400">location</span>
                    <span class="mx-2 mb-1 flex-1 border-b border-dotted border-neutral-300 dark:border-neutral-700"></span>
                    <span class="min-w-0 truncate text-right text-neutral-500">{status.location}</span>
                </div>

                <div class="flex items-baseline">
                    <span class="shrink-0 text-neutral-600 dark:text-neutral-400">current_task</span>
                    <span class="mx-2 mb-1 flex-1 border-b border-dotted border-neutral-300 dark:border-neutral-700"></span>
                    <span class="min-w-0 truncate text-right text-neutral-500">{status.current_task}</span>
                </div>

                <div class="flex items-baseline">
                    <span class="shrink-0 text-neutral-600 dark:text-neutral-400">reading</span>
                    <span class="mx-2 mb-1 flex-1 border-b border-dotted border-neutral-300 dark:border-neutral-700"></span>
                    <span class="min-w-0 truncate text-right text-neutral-500">{status.current_reading}</span>
                </div>

                <div class="flex items-baseline">
                    <span class="shrink-0 text-neutral-600 dark:text-neutral-400">now_playing</span>
                    <span class="mx-2 mb-1 flex-1 border-b border-dotted border-neutral-300 dark:border-neutral-700"></span>
                    <span class="flex min-w-0 justify-end text-right">
                        <NowPlaying variant="stat" />
                    </span>
                </div>
            </div>
        </div>

        <!-- links -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm">
            <a href="mailto:jester@fool.ltd" class="text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">[email]</a>
            <a href="https://discord.gg/M6NfuNSrZd" target="_blank" rel="noopener noreferrer" class="text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">[discord]</a>
            <a href="https://instagram.com/egocni" target="_blank" rel="noopener noreferrer" class="text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">[instagram]</a>
            <a href="/blog" class="text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">[blog]</a>
        </div>
    </div>
</header>
