---
// friends: [ name ] roulette — names slot-roll into the brackets.
// Edit the list in src/data/friends.json; "url" is optional and makes
// the name a link while it's showing.
import friendsData from '../data/friends.json';

const friends = friendsData as { name: string; url?: string }[];
const maxLen = Math.max(1, ...friends.map(f => f.name.length));
---

<span class="inline-flex items-center gap-1.5">
    <span class="text-neutral-600 dark:text-neutral-400">friends:</span>
    <span class="select-none text-neutral-400 dark:text-neutral-600">[</span>
    <span id="friend-reel" class="relative inline-block h-4 overflow-hidden align-bottom" style={`width: ${maxLen + 1}ch;`}>
        {friends.map(f => f.url ? (
            <a
                href={f.url}
                target="_blank"
                rel="noopener noreferrer"
                class="friend-item glow-hover absolute inset-0 truncate text-center leading-4 text-neutral-800 underline decoration-dotted underline-offset-2 transition-transform duration-500 hover:text-neutral-500 dark:text-neutral-200 dark:hover:text-neutral-400"
                style="transform: translateY(140%);"
            >{f.name}</a>
        ) : (
            <span
                class="friend-item absolute inset-0 truncate text-center leading-4 text-neutral-800 transition-transform duration-500 dark:text-neutral-200"
                style="transform: translateY(140%);"
            >{f.name}</span>
        ))}
    </span>
    <span class="select-none text-neutral-400 dark:text-neutral-600">]</span>
</span>

<script>
    const reel = document.getElementById('friend-reel');
    const items = reel ? Array.from(reel.querySelectorAll<HTMLElement>('.friend-item')) : [];

    if (items.length > 0) {
        // shuffled order each visit, like a dice roll
        const order = items.map((_, i) => i).sort(() => Math.random() - 0.5);
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) items.forEach(el => (el.style.transitionDuration = '0s'));

        let pos = 0;
        let current = items[order[0]];
        current.style.transform = 'translateY(0)';

        if (items.length > 1) {
            setInterval(() => {
                const prev = current;
                pos = (pos + 1) % order.length;
                current = items[order[pos]];

                prev.style.transform = 'translateY(-140%)';

                // park the incoming name below the box without animating,
                // then let it slide up into view
                current.style.transitionProperty = 'none';
                current.style.transform = 'translateY(140%)';
                void current.offsetHeight;
                current.style.transitionProperty = '';
                current.style.transform = 'translateY(0)';
            }, 2400);
        }
    }
</script>
