---
import Base from '../layouts/base.astro';
import "@pagefind/default-ui/css/ui.css";

const bundlePath = new URL("pagefind/", import.meta.env.SITE || "http://localhost:4321/").pathname;
---

<Base>
    <div class="mt-6 flex flex-1 flex-col border border-neutral-200 dark:border-neutral-800">
        <div class="flex items-center justify-between border-b border-neutral-200 px-3 py-2 text-xs dark:border-neutral-800">
            <span class="font-bold text-neutral-700 dark:text-neutral-300">fool.ltd <span class="text-neutral-400 dark:text-neutral-600">/search</span></span>
            <a href="/blog" class="text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">
                ../ blog
            </a>
        </div>

        <div class="p-4 sm:p-6">
            <div data-pagefind-ui data-bundle-path={bundlePath}></div>
        </div>
    </div>
</Base>

<script>
    import { PagefindUI } from "@pagefind/default-ui";

    window.addEventListener("DOMContentLoaded", () => {
        const el = document.querySelector("[data-pagefind-ui]");
        if (!el) return;

        new PagefindUI({
            element: "[data-pagefind-ui]",
            bundlePath: el.getAttribute("data-bundle-path") || "/pagefind/",
            showImages: false,
            debounceTimeoutMs: 150,
            showSubResults: true,
            excerptLength: 40,
            resetStyles: false,
        });

        const input = el.querySelector<HTMLInputElement>('input[type="text"]');
        if (input) input.placeholder = "What are you looking for?";
    });
</script>

<style>
    /* Pagefind token variables — all values pulled from the Tailwind palette */
    :global([data-pagefind-ui]) {
        font-family: inherit !important;
        --pagefind-ui-scale: 1;
        --pagefind-ui-primary: theme('colors.neutral.900');
        --pagefind-ui-text: theme('colors.neutral.800');
        --pagefind-ui-background: transparent;
        --pagefind-ui-border: theme('colors.neutral.200');
        --pagefind-ui-border-radius: 0;
        --pagefind-ui-tag: theme('colors.neutral.200');
        --pagefind-ui-font: inherit;
    }

    :global(.dark [data-pagefind-ui]) {
        --pagefind-ui-primary: theme('colors.neutral.100');
        --pagefind-ui-text: theme('colors.neutral.300');
        --pagefind-ui-background: transparent;
        --pagefind-ui-border: theme('colors.neutral.800');
        --pagefind-ui-tag: theme('colors.neutral.800');
    }

    /* All elements inherit font, no radius */
    :global([data-pagefind-ui] *) {
        font-family: inherit !important;
        border-radius: 0 !important;
    }

    /* Hide pagefind's own search icon (rendered as a ::before on the form) */
    :global([data-pagefind-ui] .pagefind-ui__search-icon),
    :global([data-pagefind-ui] .pagefind-ui__form::before) {
        display: none !important;
        content: none !important;
        background-image: none !important;
    }

    /* Input */
    :global([data-pagefind-ui] input[type="text"]) {
        width: 100% !important;
        padding: 0.65rem 1rem !important;
        font-size: 0.9rem !important;
        border: 1px solid var(--pagefind-ui-border) !important;
        background: transparent !important;
        background-image: none !important;
        color: var(--pagefind-ui-text) !important;
        transition: border-color 0.2s ease !important;
        box-sizing: border-box !important;
        margin: 0 !important;
    }

    :global([data-pagefind-ui] form) {
        margin: 0 !important;
        padding: 0 !important;
    }

    :global([data-pagefind-ui] input[type="text"]:focus) {
        outline: none !important;
        border-color: theme('colors.neutral.500') !important;
        box-shadow: none !important;
    }

    :global([data-pagefind-ui] input[type="text"]::placeholder) {
        color: theme('colors.neutral.400') !important;
        opacity: 1 !important;
    }

    /* Clear button */
    :global([data-pagefind-ui] .pagefind-ui__search-clear) {
        background: transparent !important;
        color: theme('colors.neutral.400') !important;
        border: none !important;
        padding: 0 0.75rem !important;
    }

    :global([data-pagefind-ui] .pagefind-ui__search-clear:hover) {
        color: var(--pagefind-ui-primary) !important;
    }

    /* Result count message */
    :global([data-pagefind-ui] .pagefind-ui__message) {
        color: theme('colors.neutral.500') !important;
        font-size: 0.8rem !important;
        padding: 1rem 0 0.5rem !important;
    }

    /* Result list */
    :global([data-pagefind-ui] .pagefind-ui__results) {
        margin-top: 0.5rem !important;
    }

    /* Individual result */
    :global([data-pagefind-ui] .pagefind-ui__result) {
        border-bottom: 1px solid var(--pagefind-ui-border) !important;
        padding: 1.1rem 0.5rem !important;
        margin: 0 !important;
        transition: background 0.15s ease !important;
        list-style: none !important;
    }

    :global([data-pagefind-ui] .pagefind-ui__result:hover) {
        background: theme('colors.neutral.200 / 40%') !important;
    }

    :global(.dark [data-pagefind-ui] .pagefind-ui__result:hover) {
        background: theme('colors.neutral.800 / 30%') !important;
    }

    /* Result link / title */
    :global([data-pagefind-ui] .pagefind-ui__result-link) {
        font-size: 0.95rem !important;
        font-weight: bold !important;
        color: var(--pagefind-ui-text) !important;
        text-decoration: none !important;
    }

    :global([data-pagefind-ui] .pagefind-ui__result-link:hover) {
        color: var(--pagefind-ui-primary) !important;
        text-decoration: underline dotted !important;
        text-underline-offset: 4px !important;
    }

    /* Excerpt */
    :global([data-pagefind-ui] .pagefind-ui__result-excerpt) {
        color: theme('colors.neutral.500') !important;
        font-size: 0.8rem !important;
        margin-top: 0.35rem !important;
        line-height: 1.6 !important;
    }

    /* Highlight marks */
    :global([data-pagefind-ui] mark) {
        background: theme('colors.neutral.300') !important;
        color: theme('colors.neutral.900') !important;
        padding: 0 2px !important;
    }

    :global(.dark [data-pagefind-ui] mark) {
        background: theme('colors.neutral.700') !important;
        color: theme('colors.neutral.100') !important;
    }

    /* Sub-results */
    :global([data-pagefind-ui] .pagefind-ui__result-nested) {
        border-left: 1px solid var(--pagefind-ui-border) !important;
        margin-left: 1rem !important;
        padding-left: 0.75rem !important;
        margin-top: 0.5rem !important;
    }

    /* Load more button */
    :global([data-pagefind-ui] .pagefind-ui__button) {
        display: block !important;
        margin: 2rem auto 0 !important;
        padding: 0.5rem 2rem !important;
        border: 1px solid var(--pagefind-ui-border) !important;
        background: transparent !important;
        color: var(--pagefind-ui-text) !important;
        cursor: pointer !important;
        font-family: inherit !important;
        font-size: 0.85rem !important;
        transition: border-color 0.2s, color 0.2s !important;
    }

    :global([data-pagefind-ui] .pagefind-ui__button:hover) {
        border-color: theme('colors.neutral.500') !important;
        color: var(--pagefind-ui-primary) !important;
    }

    :global([data-pagefind-ui-drawer]) {
        display: none !important;
    }
</style>
