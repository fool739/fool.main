---
import { getCollection } from 'astro:content';
import Base from '../../layouts/base.astro';
import BlogShell from '../../components/BlogShell.astro';
import Tag from '../../components/Tag.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const allTags = [...new Set(posts.flatMap(post => post.data.tags))].sort();

// Sort latest first by default
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
    <BlogShell activeSlug={null}>
        <header class="mb-6">
            <h1 class="text-lg font-bold text-neutral-900 dark:text-neutral-100"># blog</h1>
            <p data-pagefind-ignore class="mt-1 text-sm text-neutral-500">writings without restrain :]</p>
        </header>

        <!-- Tag filter + search link -->
        <div data-pagefind-ignore class="mb-4 flex items-center justify-between gap-4 text-xs">
            <div class="flex flex-wrap gap-x-3 gap-y-1" id="tag-filters">
                <button class="tag-pill-filter active font-bold text-neutral-900 transition-colors dark:text-neutral-100" data-tag="">
                    [all]
                </button>
                {allTags.map(tag => (
                    <button class="tag-pill-filter text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100" data-tag={tag}>
                        [{tag}]
                    </button>
                ))}
            </div>

            <a href="/search" class="glow-hover shrink-0 text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100">
                [search]
            </a>
        </div>

        <!-- Post list -->
        <div id="posts-container" class="flex flex-col border-t border-neutral-200 dark:border-neutral-800">
            {posts.length === 0 && (
                <p class="py-6 text-center text-xs italic text-neutral-400 dark:text-neutral-600">nothing here yet_</p>
            )}
            {posts.map((post, i) => (
                <a href={`/blog/${post.id.replace(/\.[^.]+$/, '')}`}
                   class="post-card fade-in block border-b border-neutral-200 py-4 no-underline transition-colors hover:bg-neutral-200/40 dark:border-neutral-800 dark:hover:bg-neutral-800/30"
                   style={`animation-delay: ${0.05 + i * 0.07}s;`}
                   data-tags={post.data.tags.join(',')}>
                    <div class="flex flex-col gap-1 px-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                        <h2 class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
                            {post.data.title}
                        </h2>
                        <div class="flex shrink-0 flex-wrap items-center gap-2 text-xs">
                            <time datetime={post.data.date.toISOString()} class="text-neutral-400 dark:text-neutral-600">
                                {new Intl.DateTimeFormat('en-US', {
                                    month: '2-digit',
                                    day: '2-digit',
                                    year: 'numeric'
                                }).format(post.data.date)}
                            </time>
                            <div class="flex flex-wrap gap-1.5">
                                {post.data.tags.map(tag => (
                                    <Tag name={tag} />
                                ))}
                            </div>
                        </div>
                    </div>
                    <p class="mt-1 line-clamp-1 px-2 text-xs text-neutral-500">
                        {post.data.description}
                    </p>
                </a>
            ))}
        </div>
    </BlogShell>
</Base>

<script>
    const filters = document.querySelectorAll<HTMLButtonElement>('.tag-pill-filter');
    const posts   = document.querySelectorAll<HTMLElement>('.post-card');

    const activeClasses = ['active', 'font-bold', 'text-neutral-900', 'dark:text-neutral-100'];
    const idleClasses   = ['text-neutral-500', 'hover:text-neutral-900', 'dark:hover:text-neutral-100'];

    filters.forEach(btn => {
        btn.addEventListener('click', () => {
            filters.forEach(b => {
                b.classList.remove(...activeClasses);
                b.classList.add(...idleClasses);
            });
            btn.classList.add(...activeClasses);
            btn.classList.remove(...idleClasses);

            const selected = btn.dataset.tag || '';
            posts.forEach(post => {
                const tags = post.dataset.tags || '';
                post.style.display = (!selected || tags.split(',').includes(selected)) ? '' : 'none';
            });
        });
    });
</script>
